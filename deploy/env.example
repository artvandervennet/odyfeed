# Settings for OdyFeed on the Pi. Copy to ~/.config/odyfeed.env and fill in.
# The deploy script and pm2 both read it. Keep it readable by you only: chmod 600.

NODE_ENV=production

# The port Cloudflare Tunnel connects to.
PORT=3000

# The public address. ActivityPub ids and the Solid client id are built from it.
BASE_URL=https://odyfeed.example.com

ACTIVITYPUB_PAGE_SIZE=20

# Used to write the mythological actors' posts.
OPENAI_API_KEY=
